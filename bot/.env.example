# Required durable PostgreSQL database. Do not use Heroku's temporary filesystem for auth.
DATABASE_URL=postgres://user:password@host:5432/database?sslmode=require
# Required: WhatsApp numbers (country code, digits only), comma-separated
OWNER_NUMBERS=15551234567
# Optional: set for first pairing only. Remove after pairing.
PAIRING_NUMBER=
# Optional non-secret namespace for an isolated PostgreSQL-backed WhatsApp session.
# Accepts 1-64 letters, numbers, spaces, underscores, or hyphens (for example: tesla md).
# Leave blank to preserve the existing default session.
SESSION_ID=
BOT_MODE=private
PREFIX=.
# Optional, default off. When true, sends incoming direct-chat text to OpenAI for a reply.
# Requires OPENAI_API_KEY. Group chats and prefixed commands are not auto-replied to.
AUTO_REPLY=false
# Optional AI integrations
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
# Optional provider-backed utilities
OPENWEATHER_API_KEY=
TAVILY_API_KEY=
DEEPL_API_KEY=
# Optional: compatible trusted HTTPS media provider, required by .download
MEDIA_PROVIDER_URL=
MEDIA_PROVIDER_KEY=
# Optional: HTTPS deployment pipeline hook, required by .updatebot
HEROKU_DEPLOY_WEBHOOK=
